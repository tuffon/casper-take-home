# Copy this file to .env.local and fill in your Supabase project's values.
# Find them in the Supabase dashboard under Project Settings → API Keys.
#
# Both values are meant to be public: the publishable key can only do what
# Row Level Security policies allow. Never put a secret or service_role key
# in this app.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
